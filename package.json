{
  "name": "enterprise-reporting-system",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"magenta,cyan\" \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w server && npm run build -w client",
    "start": "node server/dist/index.js",
    "seed": "npm run seed -w server",
    "lint": "npm run lint -w client && npm run lint -w server"
  },
  "devDependencies": {
    "@types/winston": "^2.4.4",
    "concurrently": "^9.2.1",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  },
  "dependencies": {
    "@google/genai": "^1.50.1",
    "@types/express-rate-limit": "^5.1.3",
    "express-rate-limit": "^8.4.1",
    "helmet": "^8.1.0",
    "llamaindex": "^0.12.1",
    "react-hot-toast": "^2.6.0",
    "winston": "^3.19.0",
    "zod": "^4.3.6"
  }
}
